#!name=NodeSeek 自动签到
#!desc=仅 iPhone 执行，Mac/iPad 自动跳过。每天 08:00 签到；首次登录刷新首页获取凭证，再手动验证。
#!author=kkdove2011, kqdmaomao
#!homepage=https://github.com/kkdove2011/loon-config

[Script]
http-request ^https:\/\/www\.nodeseek\.com\/(?:\?.*|(?:board|search)(?:[/?].*)?)?$ script-path=https://raw.githubusercontent.com/kkdove2011/loon-config/main/scripts/nodeseek_checkin.js, requires-body=false, timeout=10, tag=NodeSeek Cookie 获取, enable=true
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/kkdove2011/loon-config/main/scripts/nodeseek_checkin.js, timeout=35, argument="random=true&quiet=true", tag=NodeSeek 每日签到, enable=true
generic script-path=https://raw.githubusercontent.com/kkdove2011/loon-config/main/scripts/nodeseek_checkin.js, timeout=35, argument="random=true", tag=NodeSeek 手动签到, enable=true
generic script-path=https://raw.githubusercontent.com/kkdove2011/loon-config/main/scripts/nodeseek_checkin.js, timeout=35, argument="random=true&force=true", tag=NodeSeek 强制核验, enable=true
generic script-path=https://raw.githubusercontent.com/kkdove2011/loon-config/main/scripts/nodeseek_checkin.js, timeout=10, argument="action=clear", tag=NodeSeek 清除凭证, enable=true

[Mitm]
hostname = www.nodeseek.com
