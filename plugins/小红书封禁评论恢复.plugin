#!name = 小红书封禁评论恢复
#!desc = 尝试恢复当前登录账号的评论入口，默认选中评论页。仅修改含封禁标记的个人主页响应；不改变服务端封禁状态，不自动删除评论。实验功能，实际效果待手机验证。
#!author = kkdove2011
#!date = 2026-10-25

[Rewrite]
^https://edith\.xiaohongshu\.com/api/sns/v3/user/me(?:\?|$) response-body-json-jq '(.data|select(.is_recommend_level_illegal==true))|=(.is_recommend_level_illegal=false|del(.illegal_info)|.hula_tabs.tab_id_selected="comment")'

[Mitm]
hostname = edith.xiaohongshu.com
